# Supabase project credentials.
# Copy to .env and fill in from Supabase Dashboard > Settings > API.
# Use the anon/publishable key only. NEVER put the service_role key here —
# this file is bundled into the app and is readable by anyone who has the APK.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
